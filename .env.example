# Local server only. Never put credentials in src/, browser settings, or a ZIP.
# Get a dedicated partner key from the CRM developer portal. Never use an admin JWT.
TALIA_PARTNER_API_KEY=

# Optional: leave blank to use Continue with ChatGPT in the local Sell screen.
# An API key, if configured, uses its own API billing instead of the ChatGPT plan.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-astra

# Default: show the live trade reference and AI findings, with no invented deductions.
WATCHIFY_PRICE_BASELINE=unspecified
# Only for explicit experimental appraisal tests: excellent_full_set.
# This is a Watchify assumption, NOT a baseline certified by the pricing provider.

PORT=3000

# Hosted Zeit test preview: public project identifiers only.
# These values are embedded in the browser build. Never use a service-role or secret key.
WATCHIFY_SUPABASE_URL=
WATCHIFY_SUPABASE_PUBLISHABLE_KEY=
